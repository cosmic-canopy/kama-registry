# Copy to .env and fill in. Loaded by `./ops`. Only `./ops deploy` needs secrets — publish and check run
# offline. Add the SAME names+values as GitHub Actions secrets (repo or org level) for the deploy workflow.

# Cloudflare Pages deploy — the same token and account the kama site uses.
CLOUDFLARE_API_TOKEN=  # scopes: Account->Cloudflare Pages:Edit
CLOUDFLARE_ACCOUNT_ID= # Cloudflare dashboard -> Account ID

# Optional: the compiler `./ops publish` runs. Defaults to `kama` on PATH.
# KAMA=/path/to/kama
