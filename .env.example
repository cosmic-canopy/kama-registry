# Copy to .env and fill in. Loaded by `./ops`: `./ops publish` uploads tarballs to R2 with it, and
# `./ops deploy` deploys to Pages. `tools/check.py` needs no secret (it reads the bucket's public domain).
# Add the SAME names+values as GitHub Actions secrets (repo or org level) for the deploy workflow.

# The same token and account the kama site uses.
CLOUDFLARE_API_TOKEN=  # scopes: Account->Cloudflare Pages:Edit, Account->Workers R2 Storage:Edit
CLOUDFLARE_ACCOUNT_ID= # Cloudflare dashboard -> Account ID

# Optional: the compiler `./ops publish` runs. Defaults to `kama` on PATH.
# KAMA=/path/to/kama
